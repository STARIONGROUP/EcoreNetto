<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <Title>ECoreNetto.Extensions</Title>
        <Version>9.0.0</Version>
        <Description>Extension methods for the ECoreNetto library that are typically used to support code generation</Description>
        <PackageId>ECoreNetto.Extensions</PackageId>
        <AssemblyTitle>EcoreNetto.Extensions</AssemblyTitle>
        <PackageTags>Ecore modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Fix] add guard/null checks in extensions; correct NameEqualsEnclosingType arity; fixes #45
            [Update] enable nullable reference types; fixes #49
            [Update] adopt central package management; fixes #47
            [Update] ECoreNetto to version 9.0.0
            [Update] Microsoft.SourceLink.GitHub to version 10.0.300
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ECoreNetto\ECoreNetto.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>
</Project>
