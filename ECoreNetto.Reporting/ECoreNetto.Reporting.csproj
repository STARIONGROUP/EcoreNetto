<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <Title>ECoreNetto.Reporting</Title>
        <Version>9.0.0</Version>
        <Description>Ecore Reporting use in combination with the ECoreNetto library generate reports</Description>
        <PackageId>ECoreNetto.Reporting</PackageId>
        <AssemblyTitle>EcoreNetto.Reporting</AssemblyTitle>
        <PackageTags>Ecore HandleBars Reporting modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Update] enable nullable reference types solution-wide; resolve all nullable warnings; fixes #49
            [Fix] write Excel info-sheet ns-uri to its own row so ns-prefix is not overwritten; fixes #30
            [Feature] Consolidate duplicated ResourceLoader into shared Reporting implementation; fixes #44
            [Fix] Resolve cross-file .ecore references when file name differs from package name; fixes #79
            [Feature] Bring the HTML report generator to parity with uml4net; fixes #112
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Templates\ecore-to-html-docs.hbs" />
      <None Remove="Templates\ecore-to-markdown-docs.hbs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Templates\ecore-to-html-docs.hbs">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\ecore-to-markdown-docs.hbs">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ECoreNetto.HandleBars\ECoreNetto.HandleBars.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" />
        <PackageReference Include="Microsoft.Msagl" />
        <PackageReference Include="Svg" />
    </ItemGroup>

    <ItemGroup Label="Transitive Dependency overrides">
        <PackageReference Include="System.IO.Packaging" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
