<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Package">
        <LangVersion>14.0</LangVersion>
        <Title>ECoreNetto.Tools</Title>
        <Description>A command line application that processes an Ecore file and generates various reports.</Description>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <PackageId>ECoreNetto.Tools</PackageId>
        <ToolCommandName>ecoretools</ToolCommandName>
        <Version>9.0.0</Version>
        <ImplicitUsings>disable</ImplicitUsings>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <PackageTags>Ecore HandleBars Reporting modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Update] enable nullable reference types solution-wide; resolve all nullable warnings; fixes #49
            [Fix] correct copy-paste XML-doc errors in report commands/generators; rename generatedHtml; fixes #43
            [Make] ReportHandler properly async and testable; fixes #41
            [Fix] make VersionChecker URL/timeout configurable, improve logging, and parse tags safely; fixes #33
            [Feature] Bring the HTML report generator to parity with uml4net; fixes #112
            [Feature] Generate a single combined report across multiple .ecore files; #113
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Resources\ascii-art.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\ascii-art.txt">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Spectre.Console" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="icon.ico" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ECoreNetto.Reporting\ECoreNetto.Reporting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
