<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Package">
        <LangVersion>14.0</LangVersion>
        <Title>ECoreNetto.Tools</Title>
        <Description>A command line application that processes an Ecore file and generates various reports.</Description>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <PackAsTool>true</PackAsTool>
        <PackageId>ECoreNetto.Tools</PackageId>
        <ToolCommandName>ecoretools</ToolCommandName>
        <Version>9.0.0</Version>
        <ImplicitUsings>disable</ImplicitUsings>
        <ApplicationIcon>icon.ico</ApplicationIcon>
        <PackageTags>Ecore HandleBars Reporting modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Fix] VersionChecker logging, timeout, URL and tag-name parsing; fixes #33
            [Fix] correct copy-paste XML-doc errors in report commands; fixes #43
            [Improve] make ReportHandler properly async and testable; fixes #41
            [Update] write log file as ecorenetto.logs; fixes #42
            [Update] enable nullable reference types; fixes #49
            [Update] adopt central package management; fixes #47
            [Update] ECoreNetto.Reporting to version 9.0.0
            [Update] Autofac.Extensions.DependencyInjection to version 11.0.1
            [Update] Microsoft.Extensions.Hosting to version 10.0.9
            [Update] Microsoft.Extensions.Http to version 10.0.9
            [Update] System.CommandLine to version 2.0.9
            [Update] Spectre.Console to version 0.57.0
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
      <None Remove="Resources\ascii-art.txt" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\ascii-art.txt">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
        <PackageReference Include="System.CommandLine" />
        <PackageReference Include="Spectre.Console" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="icon.ico" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ECoreNetto.Reporting\ECoreNetto.Reporting.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
