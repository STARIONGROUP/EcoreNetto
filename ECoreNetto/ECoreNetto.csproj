<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>10.0</LangVersion>
        <Title>EcoreNetto</Title>
        <Version>9.0.0</Version>
        <Description>ECoreNetto is a dotnet core library that is used to deserialize an Ecore meta-model for the purpose of code generation. Ecore is a meta-model used to represent models in the Eclipse Modelling Framework. EMF is a powerful framework and code generation facility for building Java applications based on simple model definitions. The intention of ECoreNetto is not to be a port of EMF, it aims at bridging the gap to the .NET world to facilitate code generation of C# class libraries based on an Ecore model using the .NET code available tooling and libraries.</Description>
        <PackageId>ECoreNetto</PackageId>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <AssemblyTitle>EcoreNetto</AssemblyTitle>
        <PackageTags>Ecore modeltopia</PackageTags>
        <PackageReleaseNotes>
            [Add] tests for ContainmentUpdater and EcoreObjectFactory; fix EEnumLiteral removal and EStringToStringMapEntry; fixes #52
            [Update] enable nullable reference types solution-wide; resolve all nullable warnings; fixes #49
            [Fix] harden ECore XML parsing against XXE (prohibit DTDs, null XmlResolver); #29
            [Fix] Guard unsafe casts on GetEObject(...) results; fixes #32
            [Feature] Populate Resource.Errors with diagnostics during parse; fixes #35
            [Fix] validate attribute values before parsing; fixes #37
            [Feature] implement Resource.GetURIFragment as the inverse of GetEObject; fixes #76
            [Feature] implement EObject.EClass() (return the meta class); fixes #10
            [Feature] add error handling around parse/load; fixes #36
            [Fix] honor loadOnDemand in ResourceSet.Resource; fixes #39
            [Fix] resolve cross-file .ecore references when file name differs from package name; fixes #79
            [Fix] guarantee Resource.GetEObject terminates on unresolvable fragments; fixes #80
            [Fix] remove static TopPackageName and harden URI-based reference handling; fixes #31
            [Fix] populate Resource.Contents on load and dedup ResourceSet.CreateResource; fixes #82, fixes #84
            [Fix] resolve built-in Ecore types by exact key; fixes #83
            [Fix] disambiguate duplicate ENamedElement identifiers so overloaded EOperations load; fixes #96
            [Feature] read Ecore generics and operation exceptions; fixes #97
            [Fix] resolve references into the XMLType namespace; fixes #98
            [Feature] read eKeys/instanceTypeName/literal/annotation references and unwrap xmi:XMI; fixes #99
            [Feature] resolve positional @feature.index and bare xmi:id URI fragments; fixes #106
            [Feature] Bring the HTML report generator to parity with uml4net; fixes #112
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    </ItemGroup>

</Project>
